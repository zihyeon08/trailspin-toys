---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const games = await getAllGames(database);
const categories = await getAllCategories(database);
const publishers = await getAllPublishers(database);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-400" data-testid="games-count" aria-live="polite">
          {games.length} {games.length === 1 ? 'game' : 'games'} shown
        </p>
      </div>

      <form
        class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg md:grid-cols-[1fr_16rem] md:items-start"
        data-testid="game-filters"
        aria-label="Filter games"
      >
        <fieldset>
          <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {categories.map((category) => (
              <label class="flex items-center gap-2 text-sm text-slate-300" data-testid={`category-filter-${category.id}`}>
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-testid={`category-checkbox-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </div>

        <div class="flex items-center gap-4 md:col-span-2">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="apply-filters"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="text-sm font-medium text-slate-300 underline decoration-slate-500 underline-offset-4 transition-colors hover:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters"
          >
            Clear filters
          </a>
        </div>
      </form>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const count = document.querySelector<HTMLElement>('[data-testid="games-count"]');

  if (filterForm && emptyState && count) {
    const categoryInputs = Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherInput = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const applyFilters = (updateUrl: boolean): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const selectedPublisher = publisherInput?.dataset.filterValue ?? publisherInput?.value ?? '';
      let visibleCount = 0;

      for (const card of cards) {
        const matchesCategory =
          selectedCategories.size === 0 ||
          selectedCategories.has(card.dataset.categoryId ?? '');
        const matchesPublisher =
          selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
        const visible = matchesCategory && matchesPublisher;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount++;
      }

      emptyState.classList.toggle('hidden', visibleCount !== 0);
      count.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;

      if (updateUrl) {
        const params = new URLSearchParams();
        for (const category of selectedCategories) params.append('category', category);
        if (selectedPublisher) params.set('publisher', selectedPublisher);
        const query = params.toString();
        window.history.replaceState({}, '', query ? `/?${query}` : '/');
      }
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    for (const input of categoryInputs) input.checked = selectedCategories.has(input.value);
    if (publisherInput) {
      const initialPublisher = params.get('publisher') ?? '';
      if (initialPublisher && !Array.from(publisherInput.options).some((option) => option.value === initialPublisher)) {
        publisherInput.dataset.filterValue = initialPublisher;
      } else {
        publisherInput.value = initialPublisher;
      }
    }

    filterForm.addEventListener('submit', (event) => {
      event.preventDefault();
      delete publisherInput?.dataset.filterValue;
      applyFilters(true);
    });
    applyFilters(false);
  }
</script>
